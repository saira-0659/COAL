[org 0x0100]
jmp start

clrscr: push es
push ax
push cx
push di
mov ax, 0xb800
mov es, ax
xor di, di
mov ax, 0x0720
mov cx, 2000
cld
rep stosw
pop di
pop cx
pop ax
pop es
ret

drawrect:               ;border
push bp
mov bp, sp
push es
push ax
push cx
push dx
push di

cld
mov ax, 0xb800
mov es, ax

                        ;top row
mov al, 80
mul byte [bp+10]
add ax, [bp+8]
shl ax, 1
mov di, ax

mov ah, 0x0B
mov al, 0xC9            ; top-left corner
stosw

mov cx, [bp+4]
sub cx, [bp+8]
dec cx
mov al, 0xCD            ; horizontal line
rep stosw

mov al, 0xBB            ; top-right corner
stosw

                        ;bottom row
mov al, 80
mul byte [bp+6]
add ax, [bp+8]
shl ax, 1
mov di, ax

mov ah, 0x0B
mov al, 0xC8            ; bottom-left corner
stosw

mov cx, [bp+4]
sub cx, [bp+8]
dec cx
mov al, 0xCD
rep stosw

mov al, 0xBC            ; bottom-right corner
stosw

                        ;left and right sides
mov dx, [bp+10]
inc dx

draw_sides_loop:
cmp dx, [bp+6]
jge exit

mov ax, 80
mul dl
add ax, [bp+8]
shl ax, 1
mov di, ax
mov ah, 0x0B
mov al, 0xBA            ; vertical line left
stosw

mov ax, 80
mul dl
add ax, [bp+4]
shl ax, 1
mov di, ax
mov ah, 0x0B
mov al, 0xBA            ; vertical line right
stosw

inc dx
jmp draw_sides_loop

exit:
pop di
pop dx
pop cx
pop ax
pop es
pop bp
ret 8

                        ;title yellow on blue
drawtitle:
push bp
mov bp, sp
sub sp, 2
push es
push ax
push cx
push si
push di

cld

                        ;string length
mov si, [bp+6]
mov word [bp-2], 0
count_loop:
lodsb
cmp al, 0
je count_done
inc word [bp-2]
jmp count_loop
count_done:

                        ;column = left + ((right-left+1) - length) / 2
mov ax, [bp+8]
sub ax, [bp+10]
inc ax
sub ax, [bp-2]
shr ax, 1
add ax, [bp+10]
mov cx, ax              ; CX = start column

                        ;video offset = (row*80 + column) * 2
mov al, 80
mul byte [bp+12]
add ax, cx
shl ax, 1
mov di, ax

mov ax, 0xb800
mov es, ax
mov si, [bp+6]
mov ah, [bp+4]          ; title attribute

show_title:
lodsb
cmp al, 0
je title_done
stosw
jmp show_title

title_done:
pop di
pop si
pop cx
pop ax
pop es
mov sp, bp
pop bp
ret 10

                        ;print ONE line: printline(row, col, str, attr, maxlen)
                        ;[bp+12]=row [bp+10]=col [bp+8]=str [bp+6]=attr [bp+4]=maxlen
printline:
push bp
mov bp, sp
sub sp, 2               ; local [bp-2] = characters remaining
push es
push ax
push si
push di

cld
mov ax, [bp+4]
mov [bp-2], ax          ; remaining = maxlen

                        ;video offset = (row*80 + col) * 2
mov al, 80
mul byte [bp+12]
add ax, [bp+10]
shl ax, 1
mov di, ax

mov ax, 0xb800
mov es, ax
mov si, [bp+8]
mov ah, [bp+6]          ; AH = attribute used by every STOSW

next_char:
cmp word [bp-2], 0
je line_done
lodsb                   ; AL = next character
cmp al, 0
je line_done
stosw                   ; AL = char, AH = attribute
dec word [bp-2]
jmp next_char

line_done:
pop di
pop si
pop ax
pop es
mov sp, bp
pop bp
ret 10

                        ;print many lines: drawlines(startLine, numLines, startRow)
                        ;[bp+8]=startLine [bp+6]=numLines [bp+4]=startRow
                        ;margins: left column + 2 ... right column - 2
drawlines:
push bp
mov bp, sp
sub sp, 6               ; [bp-2]=line index [bp-4]=row [bp-6]=lines remaining
push ax
push bx

mov ax, [bp+8]
mov [bp-2], ax
mov ax, [bp+4]
mov [bp-4], ax
mov ax, [bp+6]
mov [bp-6], ax

lines_loop:
cmp word [bp-6], 0
jle lines_done
mov ax, [bp-2]
cmp ax, [numLines]
jge lines_done          ; no more document lines

mov bx, ax
shl bx, 1
mov bx, [lineTable + bx]    ; BX = address of this line

push word [bp-4]        ; row
mov ax, [left]
add ax, 2
push ax                 ; column = left + 2
push bx                 ; string
mov ax, 0x07
push ax                 ; normal text attribute
mov ax, [right]
sub ax, [left]
sub ax, 3
push ax                 ; max chars = (right-2) - (left+2) + 1
call printline

inc word [bp-2]
inc word [bp-4]
dec word [bp-6]
jmp lines_loop

lines_done:
pop bx
pop ax
mov sp, bp
pop bp
ret 6

                        ;scroll ONLY the window interior up by N lines
                        ;scroll_window_up(top, left, bottom, right, n)
                        ;pass the INTERIOR coordinates so the border is never touched
                        ;[bp+12]=top [bp+10]=left [bp+8]=bottom [bp+6]=right [bp+4]=n
scroll_window_up:
push bp
mov bp, sp
sub sp, 10              ; [bp-2]=dest row offset  [bp-4]=source row offset
                        ; [bp-6]=lines to move    [bp-8]=width in words
                        ; [bp-10]=n (limited to the window height)
push es
push ds
push ax
push bx
push cx
push dx
push si
push di

cld

mov ax, [bp+6]          ; width = right - left + 1
sub ax, [bp+10]
inc ax
mov [bp-8], ax

mov ax, [bp+8]          ; height = bottom - top + 1
sub ax, [bp+12]
inc ax
mov bx, [bp+4]          ; n
cmp bx, ax
jle sc_nok
mov bx, ax              ; n cannot be bigger than the window height
sc_nok:
mov [bp-10], bx
sub ax, bx              ; lines to move = height - n
mov [bp-6], ax

                        ;destination = (top, left)
mov al, 80
mul byte [bp+12]
add ax, [bp+10]
shl ax, 1
mov [bp-2], ax

                        ;source = (top + n, left)
mov ax, [bp+12]
add ax, [bp-10]
mov bx, ax              ; BL = top + n
mov al, 80
mul bl
add ax, [bp+10]
shl ax, 1
mov [bp-4], ax

mov ax, 0xb800
mov ds, ax              ; DS = ES = video segment
mov es, ax

sc_move:                ; move one row at a time, row stride = 160 bytes
cmp word [bp-6], 0
jle sc_blank
mov si, [bp-4]
mov di, [bp-2]
mov cx, [bp-8]
rep movsw
add word [bp-4], 160
add word [bp-2], 160
dec word [bp-6]
jmp sc_move

sc_blank:               ; [bp-2] now points at the first vacated row
mov ax, 0x0720
mov dx, [bp-10]
sc_bl:
cmp dx, 0
jle sc_done
mov di, [bp-2]
mov cx, [bp-8]
rep stosw
add word [bp-2], 160
dec dx
jmp sc_bl

sc_done:
pop di
pop si
pop dx
pop cx
pop bx
pop ax
pop ds
pop es
mov sp, bp
pop bp
ret 10

start:
call clrscr

push word [top]
push word [left]
push word [bottom]
push word [right]
call drawrect

push word [top]          ; title on the top border row
push word [left]
push word [right]
mov ax, title
push ax
mov ax, 0x1E             ; yellow on blue
push ax
call drawtitle

xor ax, ax
push ax                  ; start at document line 0
mov ax, [bottom]
sub ax, [top]
dec ax
push ax                  ; number of interior rows (17)
mov ax, [top]
inc ax
push ax                  ; first interior row (4)
call drawlines

mov ah, 0                ; wait for a key, then scroll
int 0x16

mov ax, [top]
inc ax
push ax                  ; interior top    (4)
mov ax, [left]
inc ax
push ax                  ; interior left   (9)
mov ax, [bottom]
dec ax
push ax                  ; interior bottom (20)
mov ax, [right]
dec ax
push ax                  ; interior right  (71)
mov ax, 3
push ax                  ; scroll up by 3 lines
call scroll_window_up

mov ax, 17
push ax                  ; next document line (17)
mov ax, 3
push ax                  ; 3 lines
mov ax, [bottom]
sub ax, 3
push ax                  ; first vacated row (18)
call drawlines

mov ah, 0                ; wait for a key so the screen stays visible
int 0x16

mov ax, 0x4c00
int 0x21

top:    dw 3
bottom: dw 21
right:  dw 72
left:   dw 8
title:  db ' TEXT VIEWPORT MANAGER ', 0

l0:  db 'The blue whale is the largest animal ever to live on Earth.', 0
