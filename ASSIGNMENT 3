[org 0x0100]
jmp start

                        ;clrscr with REP STOSW
                        ;[bp+4]=attribute
clrscr:
push bp
mov bp, sp
sub sp, 2               ; [bp-2] = number of cells
push es
push ax
push cx
push di

mov word [bp-2], 2000   ; 80 * 25 cells
mov ax, 0xb800
mov es, ax
xor di, di
mov ah, [bp+4]          ; attribute
mov al, ' '             ; blank
mov cx, [bp-2]
cld
rep stosw

pop di
pop cx
pop ax
pop es
mov sp, bp
pop bp
ret 2

drawrect:               ;border
push bp
mov bp, sp
sub sp, 2               ; [bp-2] = current side row
push es
push ax
push cx
push di

cld
mov ax, 0xb800
mov es, ax

                        ;top row
mov al, 80
mul byte [bp+10]
add ax, [bp+8]
shl ax, 1
mov di, ax

mov ah, 0x0B
mov al, 0xC9            ; top-left corner
stosw

mov cx, [bp+4]
sub cx, [bp+8]
dec cx
mov al, 0xCD            ; horizontal line
rep stosw

mov al, 0xBB            ; top-right corner
stosw

                        ;bottom row
mov al, 80
mul byte [bp+6]
add ax, [bp+8]
shl ax, 1
mov di, ax

mov ah, 0x0B
mov al, 0xC8            ; bottom-left corner
stosw

mov cx, [bp+4]
sub cx, [bp+8]
dec cx
mov al, 0xCD
rep stosw

mov al, 0xBC            ; bottom-right corner
stosw

                        ;left and right sides
mov ax, [bp+10]
inc ax
mov [bp-2], ax          ; first side row = top + 1

draw_sides_loop:
mov ax, [bp-2]
cmp ax, [bp+6]
jge exit

mov al, 80
mul byte [bp-2]
add ax, [bp+8]
shl ax, 1
mov di, ax
mov ah, 0x0B
mov al, 0xBA            ; vertical line left
stosw

mov al, 80
mul byte [bp-2]
add ax, [bp+4]
shl ax, 1
mov di, ax
mov ah, 0x0B
mov al, 0xBA            ; vertical line right
stosw

inc word [bp-2]
jmp draw_sides_loop

exit:
pop di
pop cx
pop ax
pop es
mov sp, bp
pop bp
ret 8

                        ;title yellow on blue
drawtitle:
push bp
mov bp, sp
sub sp, 2
push es
push ax
push cx
push si
push di

cld

                        ;string length
mov si, [bp+6]
mov word [bp-2], 0
count_loop:
lodsb
cmp al, 0
je count_done
inc word [bp-2]
jmp count_loop
count_done:

                        ;column = left + ((right-left+1) - length) / 2
mov ax, [bp+8]
sub ax, [bp+10]
inc ax
sub ax, [bp-2]
shr ax, 1
add ax, [bp+10]
mov cx, ax              ; CX = start column

                        ;video offset = (row*80 + column) * 2
mov al, 80
mul byte [bp+12]
add ax, cx
shl ax, 1
mov di, ax

mov ax, 0xb800
mov es, ax
mov si, [bp+6]
mov ah, [bp+4]          ; title attribute

show_title:
lodsb
cmp al, 0
je title_done
stosw
jmp show_title

title_done:
pop di
pop si
pop cx
pop ax
pop es
mov sp, bp
pop bp
ret 10

                        ;printing one line
                        ;[bp+12]=row [bp+10]=col [bp+8]=string [bp+6]=attribute [bp+4]=maxlen
printline:
push bp
mov bp, sp
sub sp, 2               ;[bp-2] = remaining characters
push es
push ax
push si
push di

cld
mov ax, [bp+4]
mov [bp-2], ax          ; remaining = maxlen

                        ;video offset = (row*80 + col) * 2
mov al, 80
mul byte [bp+12]
add ax, [bp+10]
shl ax, 1
mov di, ax

mov ax, 0xb800
mov es, ax
mov si, [bp+8]
mov ah, [bp+6]          ; AH = attribute used by every STOSW

next_char:
cmp word [bp-2], 0
je line_done
lodsb                   ; AL = next character
cmp al, 0
je line_done
stosw                   ; AL = char, AH = attribute
dec word [bp-2]
jmp next_char

line_done:
pop di
pop si
pop ax
pop es
mov sp, bp
pop bp
ret 10

                        ;printing multiple lines: drawlines(startLine, numLines, startRow)
                        ;[bp+8]=startLine [bp+6]=numLines [bp+4]=startRow
                        ;margins: left column + 2, right column - 2
drawlines:
push bp
mov bp, sp
sub sp, 6               ; [bp-2]=line index [bp-4]=row [bp-6]=lines remaining
push ax
push bx

mov ax, [bp+8]
mov [bp-2], ax
mov ax, [bp+4]
mov [bp-4], ax
mov ax, [bp+6]
mov [bp-6], ax

lines_loop:
cmp word [bp-6], 0
jle lines_done
mov ax, [bp-2]
cmp ax, [numLines]
jge lines_done          ; no more lines

mov bx, ax
shl bx, 1
mov bx, [lineTable + bx]    ; BX = address of current line

push word [bp-4]        ; row
mov ax, [left]
add ax, 2
push ax                 ; column = left + 2
push bx                 ; string
mov ax, 0x07
push ax                 ; normal text attribute
mov ax, [right]
sub ax, [left]
sub ax, 3
push ax                 ; max chars = (right-2) - (left+2) + 1
call printline

inc word [bp-2]
inc word [bp-4]
dec word [bp-6]
jmp lines_loop

lines_done:
pop bx
pop ax
mov sp, bp
pop bp
ret 6

                        ;scroll ONLY the window interior up by N lines
                        ;[bp+12]=top [bp+10]=left [bp+8]=bottom [bp+6]=right [bp+4]=n
scroll_window_up:
push bp
mov bp, sp
sub sp, 10              ; [bp-2]=dest row offset  [bp-4]=source row offset
                        ; [bp-6]=lines to move    [bp-8]=width in words
                        ; [bp-10]=n (limited to the window height)
push es
push ds
push ax
push bx
push cx
push si
push di

cld

mov ax, [bp+6]          ; width = right - left + 1
sub ax, [bp+10]
inc ax
mov [bp-8], ax

mov ax, [bp+8]          ; height = bottom - top + 1
sub ax, [bp+12]
inc ax
mov bx, [bp+4]          ; n
cmp bx, ax
jle sc_nok
mov bx, ax              ; n cannot be bigger than the window height
sc_nok:
mov [bp-10], bx
sub ax, bx              ; lines to move = height - n
mov [bp-6], ax

                        ;destination = (top, left)
mov al, 80
mul byte [bp+12]
add ax, [bp+10]
shl ax, 1
mov [bp-2], ax

                        ;source = (top + n, left)
mov ax, [bp+12]
add ax, [bp-10]
mov bx, ax              ; BL = top + n
mov al, 80
mul bl
add ax, [bp+10]
shl ax, 1
mov [bp-4], ax

mov ax, 0xb800
mov ds, ax              ; DS = ES = video segment
mov es, ax

sc_move:                ; moving one row at a time, row stride = 160 bytes
cmp word [bp-6], 0
jle sc_blank
mov si, [bp-4]
mov di, [bp-2]
mov cx, [bp-8]
rep movsw
add word [bp-4], 160
add word [bp-2], 160
dec word [bp-6]
jmp sc_move

sc_blank:               ; [bp-2] now points at the first vacated row
mov ax, 0x0720
sc_bl:
cmp word [bp-10], 0     ; [bp-10] = rows still to blank
jle sc_done
mov di, [bp-2]
mov cx, [bp-8]
rep stosw
add word [bp-2], 160
dec word [bp-10]
jmp sc_bl

sc_done:
pop di
pop si
pop cx
pop bx
pop ax
pop ds
pop es
mov sp, bp
pop bp
ret 10

                        ;find_and_highlight(keywordOffset, attr)
                        ;for every interior row: copy the characters into a row buffer on the stack, find the first letter with REPNE SCASB, compare the rest with REPE CMPSB, and on a match overwrite ONLY the attribute bytes.
                        ;result stored in [matchCount]
                        ;[bp+6]=keyword offset  [bp+4]=highlight attribute
find_and_highlight:
push bp
mov bp, sp
sub sp, 74              ; [bp-2]=match count   [bp-4]=keyword length
                        ; [bp-6]=current row   [bp-8]=video offset of row start
                        ; [bp-10]=row width    [bp-74..bp-11]=64 byte row buffer
push es
push ds
push ax
push bx
push cx
push dx
push si
push di

cld
mov word [bp-2], 0      ; matches = 0

mov ax, [right]         ; width = right - left - 1 (interior cells per row)
sub ax, [left]
dec ax
mov [bp-10], ax

mov si, [bp+6]          ; keyword length
xor cx, cx
fh_len:
lodsb
cmp al, 0
je fh_lendone
inc cx
jmp fh_len
fh_lendone:
mov [bp-4], cx
cmp cx, 0
jne fh_haskey
jmp fh_finish           ; empty keyword: nothing to find
fh_haskey:

mov ax, [top]
inc ax
mov [bp-6], ax          ; first interior row

fh_rowloop:
mov ax, [bp-6]
cmp ax, [bottom]
jl fh_rowok
jmp fh_finish           ; passed the last interior row
fh_rowok:

                        ;offset of (row, left+1) = (row*80 + left + 1) * 2
mov al, 80
mul byte [bp-6]
add ax, [left]
inc ax
shl ax, 1
mov si, ax
mov [bp-8], ax

                        ;copy the characters of this row into the stack buffer
push ss
pop es                  ; ES = stack segment (row buffer)
lea di, [bp-74]
mov ax, 0xb800
mov ds, ax              ; DS = video segment
mov cx, [bp-10]
fh_strip:
lodsw                   ; AL = character, AH = attribute
stosb                   ; keep only the character
loop fh_strip
xor al, al
stosb                   ; 0 sentinel stops CMPSB at the end of the row
push ss
pop ds                  ; DS back to the data segment (.COM: SS = DS)

                        ;search the row buffer
lea di, [bp-74]
mov cx, [bp-10]
mov bx, [bp+6]
mov dl, [bx]            ; DL = first letter of the keyword
fh_scan:
jcxz fh_nextrow
mov al, dl
repne scasb             ; look for the first letter
jne fh_nextrow          ; not found in the rest of the row
push cx                 ; DI = character after the first letter
push di
lea si, [bx+1]          ; rest of the keyword
mov cx, [bp-4]
dec cx                  ; (also leaves ZF=1 for a 1-letter keyword)
repe cmpsb              ; compare the remaining letters
pop di
pop cx
jne fh_scan             ; mismatch: continue after the first letter

                        ;match: paint only the attribute bytes
push cx
push di
mov ax, di
dec ax
lea cx, [bp-74]
sub ax, cx              ; AX = column index of the match inside the row
shl ax, 1               ; 2 bytes per cell
add ax, [bp-8]          ; + video offset of the row start
inc ax                  ; +1 = attribute byte of the first cell
mov di, ax
mov ax, 0xb800
mov es, ax
mov al, [bp+4]          ; highlight attribute
mov cx, [bp-4]          ; one cell per keyword letter
fh_paint:
stosb                   ; write the attribute byte
inc di                  ; skip the next character byte
loop fh_paint
push ss
pop es                  ; ES back to the row buffer
pop di
pop cx

inc word [bp-2]         ; match count + 1
mov ax, [bp-4]          ; skip over the whole match
dec ax
add di, ax
sub cx, ax
jmp fh_scan

fh_nextrow:
inc word [bp-6]
jmp fh_rowloop

fh_finish:
mov ax, [bp-2]
mov [matchCount], ax    ; DS = data segment here

pop di
pop si
pop dx
pop cx
pop bx
pop ax
pop ds
pop es
mov sp, bp
pop bp
ret 4

                        ;printNum(number, row, col, attr, pEndCol)
                        ;[bp+12]=number [bp+10]=row [bp+8]=col [bp+6]=attr [bp+4]=pEndCol
printNum:
push bp
mov bp, sp
sub sp, 2               ; [bp-2] = digit count
push es
push ax
push bx
push cx
push dx
push di

cld
mov word [bp-2], 0
mov ax, [bp+12]
mov bx, 10
pn_div:
xor dx, dx
div bx                  ; AX = quotient, DX = remainder (a digit)
push dx
inc word [bp-2]
cmp ax, 0
jne pn_div

mov al, 80              ; offset = (row*80 + col) * 2
mul byte [bp+10]
add ax, [bp+8]
shl ax, 1
mov di, ax
mov ax, 0xb800
mov es, ax
mov cx, [bp-2]
pn_print:
pop ax                  ; most significant digit first
add al, '0'
mov ah, [bp+6]
stosw
loop pn_print

mov ax, [bp+8]          ; end column = col + number of digits
add ax, [bp-2]
mov bx, [bp+4]
mov [bx], ax

pop di
pop dx
pop cx
pop bx
pop ax
pop es
mov sp, bp
pop bp
ret 10

                        ;print_status(row, count)
                        ;Total Matches Found: <count> | Viewport Status: ACTIVE
                        ;[bp+6]=row  [bp+4]=count
print_status:
push bp
mov bp, sp
sub sp, 2               ; [bp-2] = column after the number
push ax

push word [bp+6]        ; "Total Matches Found: "
mov ax, [left]
push ax
mov ax, statMsg1
push ax
mov ax, 0x70
push ax
mov ax, 80
push ax
call printline

push word [bp+4]        ; the count
push word [bp+6]
mov ax, [left]
add ax, [stat1Len]
push ax
mov ax, 0x70
push ax
lea ax, [bp-2]
push ax                 ; printNum stores the end column here
call printNum

push word [bp+6]        ; " | Viewport Status: ACTIVE"
push word [bp-2]
mov ax, statMsg2
push ax
mov ax, 0x70
push ax
mov ax, 80
push ax
call printline

pop ax
mov sp, bp
pop bp
ret 4

start:
mov ax, 0x07
push ax                  ; blank attribute
call clrscr

push word [top]
push word [left]
push word [bottom]
push word [right]
call drawrect

push word [top]          ; title on the top border row
push word [left]
push word [right]
mov ax, title
push ax
mov ax, 0x1E             ; yellow on blue
push ax
call drawtitle

xor ax, ax
push ax                  ; start at document line 0
mov ax, [bottom]
sub ax, [top]
dec ax
push ax                  ; number of interior rows (17)
mov ax, [top]
inc ax
push ax                  ; first interior row (4)
call drawlines

mov ah, 0                ; wait for a key, then scroll
int 0x16

mov ax, [top]
inc ax
push ax                  ; interior top    (4)
mov ax, [left]
inc ax
push ax                  ; interior left   (9)
mov ax, [bottom]
dec ax
push ax                  ; interior bottom (20)
mov ax, [right]
dec ax
push ax                  ; interior right  (71)
mov ax, 3
push ax                  ; scroll up by 3 lines
call scroll_window_up

mov ax, 17
push ax                  ; next document line (17)
mov ax, 3
push ax                  ; 3 lines
mov ax, [bottom]
sub ax, 3
push ax                  ; first vacated row (18)
call drawlines

mov ax, keyword
push ax                  ; keyword to search for
mov ax, 0xCE
push ax                  ; blinking yellow on red
call find_and_highlight

mov ax, 23
push ax                  ; status bar row
push word [matchCount]
call print_status

mov ah, 0                ; wait for a key so the screen stays visible
int 0x16

mov ax, 0x4c00
int 0x21

top:    dw 3
bottom: dw 21
right:  dw 72
left:   dw 8
title:  db ' TEXT VIEWPORT MANAGER ', 0

l0:  db 'The blue whale is the largest animal ever to live on Earth.', 0
l1:  db 'An adult can grow to about 30 meters, longer than two buses.', 0
l2:  db 'A big blue whale can weigh as much as 150 tonnes.', 0
l3:  db 'Its heart is huge and can weigh around 180 kilograms.', 0
l4:  db 'The tongue of a blue whale can weigh as much as an elephant.', 0
l5:  db 'Blue whales have no teeth; they filter food with baleen.', 0
l6:  db 'Their diet is almost entirely made of tiny krill.', 0
l7:  db 'In feeding season one whale can eat about 4 tonnes a day.', 0
l8:  db 'A newborn calf is already about 7 meters long.', 0
l9:  db 'The calf drinks hundreds of litres of milk every day.', 0
l10: db 'A whale calf can gain around 90 kilograms each day.', 0
l11: db 'Blue whale calls are among the loudest sounds of any animal.', 0
l12: db 'The low calls can travel for many kilometers underwater.', 0
l13: db 'A blue whale usually cruises at about 5 kilometers per hour.', 0
l14: db 'When it needs to, a whale can sprint at over 30 km per hour.', 0
l15: db 'The spout of a blue whale can rise about 9 meters high.', 0
l16: db 'Blue whales can live for 80 to 90 years in the wild.', 0
l17: db 'They were hunted heavily in the 20th century.', 0
l18: db 'Today the whale is protected, but it is still endangered.', 0
l19: db 'Fun fact: a blue whale is bigger than any dinosaur known.', 0

lineTable:  dw l0, l1, l2, l3, l4, l5, l6, l7, l8, l9
            dw l10, l11, l12, l13, l14, l15, l16, l17, l18, l19
numLines:   dw 20

keyword:    db 'whale', 0
matchCount: dw 0
statMsg1:   db 'Total Matches Found: ', 0
statMsg2:   db ' | Viewport Status: ACTIVE', 0
stat1Len:   dw statMsg2 - statMsg1 - 1
