[org 0x0100]
jmp start

clrscr: push es
push ax
push cx
push di
mov ax, 0xb800
mov es, ax
xor di, di
mov ax, 0x0720
mov cx, 2000
cld
rep stosw
pop di
pop cx
pop ax
pop es
ret

drawrect:               ;border
push bp
mov bp, sp
push es
push ax
push cx
push dx
push di

cld
mov ax, 0xb800
mov es, ax

                        ;top row
mov al, 80
mul byte [bp+10]
add ax, [bp+8]
shl ax, 1
mov di, ax

mov ah, 0x0B
mov al, 0xC9            ; top-left corner
stosw

mov cx, [bp+4]
sub cx, [bp+8]
dec cx
mov al, 0xCD            ; horizontal line
rep stosw

mov al, 0xBB            ; top-right corner
stosw

                        ;bottom row
mov al, 80
mul byte [bp+6]
add ax, [bp+8]
shl ax, 1
mov di, ax

mov ah, 0x0B
mov al, 0xC8            ; bottom-left corner
stosw

mov cx, [bp+4]
sub cx, [bp+8]
dec cx
mov al, 0xCD
rep stosw

mov al, 0xBC            ; bottom-right corner
stosw

                        ;left and right sides
mov dx, [bp+10]
inc dx

draw_sides_loop:
cmp dx, [bp+6]
jge exit

mov ax, 80
mul dl
add ax, [bp+8]
shl ax, 1
mov di, ax
mov ah, 0x0B
mov al, 0xBA            ; vertical line left
stosw

mov ax, 80
mul dl
add ax, [bp+4]
shl ax, 1
mov di, ax
mov ah, 0x0B
mov al, 0xBA            ; vertical line right
stosw

inc dx
jmp draw_sides_loop

exit:
pop di
pop dx
pop cx
pop ax
pop es
pop bp
ret 8

                        ;title yellow on blue
drawtitle:
push bp
mov bp, sp
sub sp, 2
push es
push ax
push cx
push si
push di

cld

                        ;string length
mov si, [bp+6]
mov word [bp-2], 0
count_loop:
lodsb
cmp al, 0
je count_done
inc word [bp-2]
jmp count_loop
count_done:

                        ;column = left + ((right-left+1) - length) / 2
mov ax, [bp+8]
sub ax, [bp+10]
inc ax
sub ax, [bp-2]
shr ax, 1
add ax, [bp+10]
mov cx, ax              ; CX = start column

                        ;video offset = (row*80 + column) * 2
mov al, 80
mul byte [bp+12]
add ax, cx
shl ax, 1
mov di, ax

mov ax, 0xb800
mov es, ax
mov si, [bp+6]
mov ah, [bp+4]          ; title attribute

show_title:
lodsb
cmp al, 0
je title_done
stosw
jmp show_title

title_done:
pop di
pop si
pop cx
pop ax
pop es
mov sp, bp
pop bp
ret 10

start:
call clrscr

push word [top]
push word [left]
push word [bottom]
push word [right]
call drawrect

push word [top]          ; title on the top border row
push word [left]
push word [right]
mov ax, title
push ax
mov ax, 0x1E             ; yellow on blue
push ax
call drawtitle

mov ah, 0                ; wait for a key so the screen stays visible
int 0x16

mov ax, 0x4c00
int 0x21

top:    dw 3
bottom: dw 21
right:  dw 72
left:   dw 8
title:  db ' TEXT VIEWPORT MANAGER ', 0
